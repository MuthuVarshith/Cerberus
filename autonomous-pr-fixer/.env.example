# Cerberus repair agent (Phase 1). Copy to .env and fill in; never commit real values.
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=medium
LLM_SERVER_FALLBACKS=true

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

MAX_ATTEMPTS=3
MAX_TOOL_CALLS=50
MAX_AGENT_TOKENS=400000
MAX_RUN_TIME=1800
MAX_COST_PER_TASK=1.25
MAX_EVALUATION_COST=15
