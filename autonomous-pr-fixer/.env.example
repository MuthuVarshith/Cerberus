# ============================================================
# Cerberus: verification gate for bug-fix patches
# Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- GitHub App (server) -----------------------------------
# Required. An unset secret rejects every webhook delivery with 403.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# Either the PEM itself or a path to it. Never commit the key.
# GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
# SQLite run store, repository clones and run artifacts.
# CERBERUS_DATA_DIR=.cerberus-app
CERBERUS_MAX_RUNS_PER_HOUR=20
CERBERUS_RUN_TIMEOUT_SECONDS=3600
# /cerberus repair on issues: none (default) | llm | claude-code
CERBERUS_REPAIR_PATCH_SOURCE=none
# 1 = open draft PRs for admitted repairs; 0 = report only
CERBERUS_PUBLISH_REPAIRS=0

# --- CLI publishing with a token (without the App) ---------
GITHUB_TOKEN=
GITHUB_REPO_SLUG=
# Base branch for opened PRs. Set this if your default branch is not `main`.
GITHUB_BASE_BRANCH=main

# --- Model-generated tests and patches (opt-in) -------------
# Any one key is enough; the default model follows whichever is present.
# Enable with `python main.py --use-llm` / `--use-llm-repro`, or the variables below.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
CERBERUS_USE_LLM=0
CERBERUS_USE_LLM_REPRO=0
# litellm model id, e.g. anthropic/claude-sonnet-5 or openai/gpt-4o.
# CERBERUS_MODEL=

# --- Webhook development only -----------------------------
# Accept deliveries with no valid signature (local replay). Never in production.
# CERBERUS_ALLOW_UNSIGNED_WEBHOOKS=0

# --- Patch loop policy --------------------------------------
PATCH_MAX_ATTEMPTS=5
PATCH_MAX_LINES_CHANGED=200

# --- Sandbox ------------------------------------------------
SANDBOX_TIMEOUT_SECONDS=60
# docker (default; fails closed without Docker) or host-unsafe (trusted local fixtures only)
# CERBERUS_SANDBOX=docker
# CERBERUS_SANDBOX_IMAGE=cerberus-sandbox:py3.11

# --- Observability ------------------------------------------
LOG_LEVEL=INFO
RUN_ARTIFACTS_DIR=artifacts
