# ============================================================
# Cerberus: Verification-First Autonomous Software Repair Harness
# Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Required for live GitHub integration:
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPO_SLUG=

# Required for LLM-powered agents:
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Optional patch loop limits:
PATCH_MAX_ATTEMPTS=5
PATCH_MAX_LINES_CHANGED=200

# Optional sandbox limits:
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_NETWORK_DISABLED=true

# Optional observability:
LOG_LEVEL=INFO
RUN_ARTIFACTS_DIR=artifacts
