# Cerberus repair agent. Copy to .env and fill in; never commit real values.

# --- Free option: Google AI Studio (Gemini) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_EFFORT=medium
LLM_MIN_SECONDS_BETWEEN_CALLS=6     # free tier is rate-limited; requests are spaced and 429s retried
LLM_FREE_TIER=true                  # records cost as $0; set false and set prices for a paid key

# --- Paid option: Anthropic ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# LLM_SERVER_FALLBACKS=true

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

MAX_ATTEMPTS=3
MAX_TOOL_CALLS=50
MAX_AGENT_TOKENS=400000
MAX_RUN_TIME=1800
MAX_COST_PER_TASK=1.25
MAX_EVALUATION_COST=15
