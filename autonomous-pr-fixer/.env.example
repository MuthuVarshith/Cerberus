# ============================================================
# Cerberus: verification gate for bug-fix patches
# Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- GitHub integration -------------------------------------
GITHUB_TOKEN=
# Required. An unset secret rejects every webhook delivery with 403.
GITHUB_WEBHOOK_SECRET=
GITHUB_REPO_SLUG=
# Base branch for opened PRs. Set this if your default branch is not `main`.
GITHUB_BASE_BRANCH=main

# --- Model-generated tests and patches (opt-in) -------------
# Any one key is enough; the default model follows whichever is present.
# Enable with `python main.py --use-llm` / `--use-llm-repro`, or the variables below.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
CERBERUS_USE_LLM=0
CERBERUS_USE_LLM_REPRO=0
# litellm model id, e.g. anthropic/claude-sonnet-5 or openai/gpt-4o.
# CERBERUS_MODEL=

# --- Webhook-triggered runs ---------------------------------
# Local checkout the pipeline operates on. Unset => dispatch is skipped.
CERBERUS_REPO_DIR=
# Set to 0 to let webhook-triggered runs really push and open PRs.
CERBERUS_WEBHOOK_DRY_RUN=1
# Development only: accept deliveries with no valid signature.
# CERBERUS_ALLOW_UNSIGNED_WEBHOOKS=0

# --- Patch loop policy --------------------------------------
PATCH_MAX_ATTEMPTS=5
PATCH_MAX_LINES_CHANGED=200

# --- Sandbox ------------------------------------------------
SANDBOX_TIMEOUT_SECONDS=60
# docker (default; fails closed without Docker) or host-unsafe (trusted local fixtures only)
# CERBERUS_SANDBOX=docker
# CERBERUS_SANDBOX_IMAGE=cerberus-sandbox:py3.11

# --- Observability ------------------------------------------
LOG_LEVEL=INFO
RUN_ARTIFACTS_DIR=artifacts
